{
  "name": "knowledge-arena",
  "version": "2.1.0",
  "description": "Universal Knowledge Gamification Engine following Enterprise Frontend Architecture Core 2.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "test": "node gates/run-gates.mjs",
    "test:gates": "node gates/run-gates.mjs",
    "test:fast": "node gates/run-gates.mjs --level=1",
    "test:mcp": "node --test tests/unit/mcp-*.test.mjs",
    "test:mcp:integration": "node tests/integration/mcp-proxybycf.mjs",
    "security:guard": "node gates/security-guard.mjs --gate",
    "security:hook": "node gates/security-guard.mjs --hook",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "bundle": "node scripts/bundler.mjs",
    "build:vendor": "node scripts/build-vendor.mjs"
